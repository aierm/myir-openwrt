+--- a/net/wireless/scan.c
++++ b/net/wireless/scan.c
+@@ -11,7 +11,9 @@
+ #include <linux/module.h>
+ #include <linux/netdevice.h>
+ #include <linux/wireless.h>
+ #include <linux/nl80211.h>
++#include <linux/version.h>
++#include <linux/jiffies.h>
